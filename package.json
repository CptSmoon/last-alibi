{
  "name": "last-alibi",
  "private": true,
  "type": "module",
  "description": "Last Alibi: walkable 2D murder-mystery cases (first: Last Stop, Simplon-Orient). Gemini brains, Gradium voices.",
  "scripts": {
    "start": "node server/server.mjs",
    "build:prompts": "node prompts/build-prompt.mjs",
    "build:web": "node tools/build-web.mjs",
    "build:itch": "node tools/build-web.mjs --api https://last-alibi.kaisspace.workers.dev --zip",
    "dev:worker": "node tools/build-web.mjs && wrangler dev",
    "deploy": "node tools/deploy.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
